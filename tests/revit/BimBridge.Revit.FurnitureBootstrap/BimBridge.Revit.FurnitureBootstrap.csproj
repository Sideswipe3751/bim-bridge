<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/Autodesk.Versions.props" />
  <PropertyGroup>
    <TargetFramework>$(RevitTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BimBridge.Revit.FurnitureBootstrap$(RevitVersion)</AssemblyName>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallDir>
    <FurnitureOutputRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..\output\multi-agent-2024'))</FurnitureOutputRoot>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="FurnitureOutputRoot" Value="$(FurnitureOutputRoot)" />
    <Reference Include="RevitAPI"><HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <Target Name="ValidateFurnitureBootstrap" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(RevitVersion)' != '2024'" Text="This furniture test fixture is restricted to the requested Revit 2024 test scope." />
    <Error Condition="'$(ReleaseYear)' == '' Or '$(RevitTargetFramework)' == ''" Text="Resolve the existing Autodesk matrix and supply RevitTargetFramework." />
    <Error Condition="!Exists('$(RevitInstallDir)\RevitAPI.dll')" Text="Exact installed Revit API is required." />
  </Target>
</Project>
